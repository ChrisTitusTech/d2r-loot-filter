<Application
    x:Class="D2RInstaller.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#261713" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2E1D18" />
            <SolidColorBrush x:Key="TextControlBackgroundPressed" Color="#34211B" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#C79A57" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#A97A4D" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F2DEC2" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F2DEC2" />

            <SolidColorBrush x:Key="ButtonBackground" Color="#6F4A28" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#855730" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#583A1F" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#C79A57" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#D7B071" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#A97A4D" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#F2DEC2" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F7EAD6" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F2DEC2" />
        </ResourceDictionary>
    </Application.Resources>
</Application>